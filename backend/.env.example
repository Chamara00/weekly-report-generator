# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection used by the app at runtime (note the -pooler host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection used by `prisma migrate` (no pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Auth - Nest issues the JWT
# ---------------------------------------------------------------------------
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Origin allowed by CORS (the Next.js app).
FRONTEND_URL="http://localhost:3000"
PORT=3001
